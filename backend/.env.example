PORT=3001
NODE_ENV=development

# Python document processing service
PYTHON_SERVICE_URL=http://localhost:8000

# Cloudinary (required for file storage)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Gemini (required for AI-assisted handwritten answer extraction and region localization)
# If absent, extraction falls back to deterministic parsing only (no bounding boxes).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# CORS — restrict to your Next.js frontend origin in production.
# Leave unset (or set to *) during local development.
# Example: CORS_ORIGIN=https://your-app.vercel.app
CORS_ORIGIN=
