PORT=3001
NODE_ENV=development

# Python document processing service
PYTHON_SERVICE_URL=http://localhost:8000

# Cloudinary (required for file storage)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Anthropic (required for AI-assisted extraction of handwritten documents)
# If absent, extraction falls back to deterministic parsing only.
ANTHROPIC_API_KEY=
